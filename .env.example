# Copy to .env (or export in your shell). All values are optional.
PORT=3000
DATA_DIR=./data
BASE_URL=http://localhost:3000

# First admin account (created on startup if no admin exists yet)
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me

# Stripe (https://dashboard.stripe.com/apikeys). Without these the shop runs in TEST PAYMENT mode.
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# Optional: fixed secret for session cookies (otherwise generated once and stored in the database)
SESSION_SECRET=
